{
  "manifest_version": 3,
  "name": "Blurra",
  "version": "1.0",
  "description": "One-click blur for any webpage element.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.europe-west3.run.app/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["extension-styles.css"]
    }
  ]
}
